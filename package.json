{
  "name": "anchor-notes",
  "displayName": "Anchor Notes",
  "description": "소스 코드에 심은 마커(@note:라벨)에 마크다운 메모를 붙인다",
  "version": "0.1.0",
  "publisher": "irony1090",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#E39B3A",
    "theme": "light"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/irony1090/anchor-note.git"
  },
  "homepage": "https://github.com/irony1090/anchor-note#readme",
  "bugs": {
    "url": "https://github.com/irony1090/anchor-note/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "notes",
    "memo",
    "markdown",
    "annotation",
    "comments",
    "obsidian"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Anchor Notes",
      "properties": {
        "anchorNotes.markerPrefix": {
          "type": "string",
          "default": "@note:",
          "description": "코드에 심는 마커의 앞부분. 마커 = prefix + 라벨. 바꾸면 기존 마커가 전부 끊긴다"
        },
        "anchorNotes.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**"
          ],
          "markdownDescription": "마커를 찾지 않을 경로 (워크스페이스 기준 glob). `**`·`*`·`?`·`{a,b}`를 쓴다. `*.log`는 루트에서만, 어디서든 빼려면 `**/*.log`. 노트 폴더 `.notemap/`은 항상 빠진다. 바꾼 뒤 기존 앵커를 맞추려면 \"마커 다시 찾기\"를 실행한다"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anchorNotes",
          "title": "Anchor Notes",
          "icon": "media/anchor.svg"
        }
      ]
    },
    "views": {
      "anchorNotes": [
        {
          "type": "webview",
          "id": "anchorNotes.browse",
          "name": "둘러보기",
          "icon": "media/anchor.svg"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "anchorNotes.noteEditor",
        "displayName": "Anchor Notes 메모",
        "selector": [
          {
            "filenamePattern": "**/.notemap/notes/*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "anchorNotes.noteHere",
        "title": "이 줄에 메모 (열기/만들기)",
        "category": "Anchor Notes"
      },
      {
        "command": "anchorNotes.openNote",
        "title": "메모 열기",
        "category": "Anchor Notes"
      },
      {
        "command": "anchorNotes.rescan",
        "title": "마커 다시 찾기 (Rescan Workspace)",
        "category": "Anchor Notes",
        "icon": "$(refresh)"
      },
      {
        "command": "anchorNotes.deleteNote",
        "title": "메모 삭제",
        "category": "Anchor Notes"
      },
      {
        "command": "anchorNotes.findByTag",
        "title": "태그로 메모 찾기",
        "category": "Anchor Notes"
      },
      {
        "command": "anchorNotes.renameNote",
        "title": "라벨 이름 바꾸기",
        "category": "Anchor Notes"
      },
      {
        "command": "anchorNotes.noteOnFile",
        "title": "이 파일에 메모",
        "category": "Anchor Notes"
      },
      {
        "command": "anchorNotes.detachFile",
        "title": "이 파일에서 메모 떼기",
        "category": "Anchor Notes"
      },
      {
        "command": "anchorNotes.insertCode",
        "title": "메모 코드 넣기",
        "category": "Anchor Notes"
      },
      {
        "command": "anchorNotes.linkCode",
        "title": "메모 코드와 연결 (동기화)",
        "category": "Anchor Notes"
      },
      {
        "command": "anchorNotes.openBrowse",
        "title": "둘러보기 열기 (메모 찾기)",
        "category": "Anchor Notes"
      }
    ],
    "keybindings": [
      {
        "command": "anchorNotes.noteHere",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus"
      },
      {
        "command": "anchorNotes.noteHere",
        "key": "ctrl+; m",
        "mac": "cmd+; m",
        "when": "editorTextFocus"
      },
      {
        "command": "anchorNotes.openBrowse",
        "key": "ctrl+; b",
        "mac": "cmd+; b"
      },
      {
        "command": "anchorNotes.insertCode",
        "key": "ctrl+; i",
        "mac": "cmd+; i",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "anchorNotes.linkCode",
        "key": "ctrl+; l",
        "mac": "cmd+; l",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "anchorNotes.rescan",
        "key": "ctrl+; r",
        "mac": "cmd+; r"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "anchorNotes.rescan",
          "when": "view == anchorNotes.browse",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "anchorNotes.insertCode",
          "when": "editorTextFocus && !editorReadonly",
          "group": "7_anchorNotes@1"
        },
        {
          "command": "anchorNotes.linkCode",
          "when": "editorTextFocus && !editorReadonly",
          "group": "7_anchorNotes@2"
        }
      ],
      "commandPalette": [
        {
          "command": "anchorNotes.openNote",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "anchorNotes.noteOnFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "7_anchorNotes@1"
        },
        {
          "command": "anchorNotes.detachFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder && resourcePath in anchorNotes.fileNotePaths",
          "group": "7_anchorNotes@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "anchorNotes.noteOnFile",
          "when": "resourceScheme == file",
          "group": "7_anchorNotes@1"
        },
        {
          "command": "anchorNotes.detachFile",
          "when": "resourceScheme == file && resourcePath in anchorNotes.fileNotePaths",
          "group": "7_anchorNotes@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs",
    "package": "vsce package",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "marked": "^18.0.13"
  }
}
